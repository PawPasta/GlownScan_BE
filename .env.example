# Copy this file to .env.local and replace each placeholder with the local value.
GLOWSCAN_FRONTEND_DOMAIN=http://localhost:5173/

GLOWSCAN_DATABASE_HOST=localhost
GLOWSCAN_DATABASE_PORT=5432
GLOWSCAN_DATABASE_NAME=glowscan
GLOWSCAN_DATABASE_USERNAME=postgres
GLOWSCAN_DATABASE_PASSWORD=change-me
GLOWSCAN_DATABASE_SSL_MODE=disable
GLOWSCAN_DATABASE_CHANNEL_BINDING=require
GLOWSCAN_FLYWAY_BASELINE_ON_MIGRATE=false
GLOWSCAN_FLYWAY_BASELINE_VERSION=1

GLOWSCAN_AUTH_VERIFY_EMAIL_TOKEN_TTL=1h
GLOWSCAN_AUTH_VERIFY_EMAIL_RESEND_COOLDOWN=30s
GLOWSCAN_AUTH_VERIFY_EMAIL_URL=VerifyEmail
GLOWSCAN_AUTH_RESET_PASSWORD_TOKEN_TTL=1h
GLOWSCAN_AUTH_RESET_PASSWORD_RESEND_COOLDOWN=30s
GLOWSCAN_AUTH_RESET_PASSWORD_URL=ResetPassword
GLOWSCAN_AUTH_REFRESH_TOKEN_TTL=30d

GLOWSCAN_MAIL_HOST=smtp.example.com
GLOWSCAN_MAIL_PORT=587
GLOWSCAN_MAIL_USERNAME=change-me@example.com
GLOWSCAN_MAIL_PASSWORD=change-me
GLOWSCAN_MAIL_FOOTER_NOTES="GlowScan Your personal skin companion"
GLOWSCAN_MAIL_ACTION_TEMPLATE=email/account-action.html
GLOWSCAN_MAIL_DEFAULT_ENCODING=UTF-8
GLOWSCAN_MAIL_SMTP_TIMEOUT=5000

GLOWSCAN_JWT_SECRET=replace-with-a-base64-secret-of-at-least-32-bytes
GLOWSCAN_JWT_ACCESS_TOKEN_TTL=15m
GLOWSCAN_JWT_ISSUER=glowscan
GLOWSCAN_JWT_AUDIENCE=glowscan-api

GLOWSCAN_LOGIN_MAX_FAILED_ATTEMPTS=5
GLOWSCAN_LOGIN_LOCK_DURATION=15m

GLOWSCAN_CLOUDINARY_CLOUD_NAME=change-me
GLOWSCAN_CLOUDINARY_API_KEY=change-me
GLOWSCAN_CLOUDINARY_API_SECRET=change-me
GLOWSCAN_CLOUDINARY_AVATAR_ALLOWED_FORMATS=jpg,jpeg,png,webp
GLOWSCAN_CLOUDINARY_AVATAR_MAX_BYTES=5242880
GLOWSCAN_CLOUDINARY_AVATAR_MAX_DIMENSION=2048
GLOWSCAN_CLOUDINARY_AVATAR_FOLDER=glowscan/profile/avatar
GLOWSCAN_CLOUDINARY_AVATAR_UPLOAD_INTENT_TTL=5m

GLOWSCAN_CLOUDINARY_ANALYSIS_FOLDER=glowscan/skin-analysis
GLOWSCAN_CLOUDINARY_ANALYSIS_ALLOWED_FORMATS=jpg,jpeg,png,webp
GLOWSCAN_CLOUDINARY_ANALYSIS_MAX_BYTES=5242880
GLOWSCAN_CLOUDINARY_ANALYSIS_MAX_DIMENSION=2048
GLOWSCAN_CLOUDINARY_ANALYSIS_UPLOAD_INTENT_TTL=5m

GLOWSCAN_GEMINI_API_KEY=replace-with-server-only-key
GLOWSCAN_GEMINI_MODEL=gemini-3.8-flash
GLOWSCAN_GEMINI_TIMEOUT=30s
GLOWSCAN_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

GLOWSCAN_SKIN_ANALYSIS_WORKER_FIXED_DELAY=5s
GLOWSCAN_SKIN_ANALYSIS_WORKER_BATCH_SIZE=5
